yle=3D"color:#A020F0">"Precision"</span>,<span style=3D"color:#A020F0">"F1"=
</span>],RowNames=3DdefectClasses);

<span style=3D"color:#0000FF">for</span> idx =3D 1:numClasses
    numTP =3D cmTest(idx,idx);
    numFP =3D sum(cmTest(:,idx)) - numTP;
    numFN =3D sum(cmTest(idx,:),2) - numTP;

    precision =3D numTP / (numTP + numFP);
    recall =3D numTP / (numTP + numFN);

    defectClass =3D defectClasses(idx);
    prTable.Recall{defectClass} =3D recall;
    prTable.Precision{defectClass} =3D precision;
    prTable.F1(defectClass) =3D 2*precision*recall/(precision + recall);
